    product0 = 0
    product1 = 0
    product2 = 0
    if(len(x)==len(y)==3):
        product0 = (x[1]*y[2])-(x[2]*y[1])
        product1 = -((x[0]*y[2])-(x[2]*y[0]))
        product2 = (x[0]*y[1])-(x[1]*y[0])
        result_p = (product0,"i", product1,"j",product2,"k") 
